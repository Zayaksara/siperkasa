APP_NAME=SiPerkasa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://siperkasa.example.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8 database created in cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Only when the site sits behind a reverse proxy / load balancer. Comma list of IPs, or *.
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed ImportAssetsJob::$timeout (900)
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database

# Off on shared hosting (no process manager). See docs/deploy/cpanel.md section 9.
INERTIA_SSR_ENABLED=false

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@siperkasa.example.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Initial super admin (used once by `php artisan db:seed --force`).
SUPER_ADMIN_NIP=admin
SUPER_ADMIN_PASSWORD=

# /up health check fails below this much free disk (MB).
HEALTH_MIN_FREE_MB=1024

# Backups (see docs/deploy/cpanel.md section 7)
MYSQLDUMP_PATH=/usr/bin
BACKUP_NOTIFY_MAIL=
BACKUP_ARCHIVE_PASSWORD=
# Second location over SFTP. Leave BACKUP_OFFSITE_HOST empty to keep backups on this server only.
BACKUP_OFFSITE_HOST=
BACKUP_OFFSITE_PORT=22
BACKUP_OFFSITE_USERNAME=
BACKUP_OFFSITE_PASSWORD=
BACKUP_OFFSITE_PRIVATE_KEY=
BACKUP_OFFSITE_PASSPHRASE=
BACKUP_OFFSITE_ROOT=/backups/siperkasa
