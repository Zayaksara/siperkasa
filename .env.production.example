APP_NAME=SiPerkasa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://siperkasa.example.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8 database created in cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Isi HANYA jika situs benar-benar di belakang proxy / CDN. Daftar IP dipisah koma.
# Jangan isi * kecuali server hanya bisa dijangkau lewat proxy: IP dan skema (http/https) pengunjung bisa dipalsukan.
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed ImportAssetsJob::$timeout (780) and the worker --max-time (840)
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database

# Off on shared hosting (no process manager). See docs/deploy/cpanel.md section 9.
INERTIA_SSR_ENABLED=false

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@siperkasa.example.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Initial super admin (used once by `php artisan db:seed --force`).
SUPER_ADMIN_NIP=admin
SUPER_ADMIN_PASSWORD=

# /up health check fails below this much free disk (MB).
HEALTH_MIN_FREE_MB=1024
# /up juga merah jika backup terakhir lebih tua dari 26 jam atau BACKUP_NOTIFY_MAIL belum diisi (cron mati / backup gagal).
HEALTH_CHECK_BACKUP=true

# Backups (see docs/deploy/cpanel.md section 7)
MYSQLDUMP_PATH=/usr/bin
# WAJIB DIISI: alamat email admin yang membaca kabar backup gagal. Jangan pakai alamat noreply.
# Contoh: BACKUP_NOTIFY_MAIL=admin@kampus.ac.id
# Kosong = kabar gagal tidak terkirim. Setelah mengisi, kirim tes alarm (lihat docs/deploy/cpanel.md bagian 7).
BACKUP_NOTIFY_MAIL=
# Batas total ukuran backup (MB). Backup tertua dihapus jika melebihi. Naikkan tiap tahun (lihat docs/deploy/cpanel.md bagian 7).
BACKUP_MAX_MB=5000
# Password zip backup. Simpan salinannya di luar server: tanpa password ini backup tidak bisa dibuka.
BACKUP_ARCHIVE_PASSWORD=
# Lokasi kedua lewat SFTP. Menyala HANYA jika HOST, HOST_FINGERPRINT, dan BACKUP_ARCHIVE_PASSWORD semuanya diisi.
# Jika salah satu kosong, backup hanya disimpan di server ini.
BACKUP_OFFSITE_HOST=
# Sidik jari kunci server tujuan, format SHA256:xxxx (lihat docs/deploy/cpanel.md bagian 7).
BACKUP_OFFSITE_HOST_FINGERPRINT=
BACKUP_OFFSITE_PORT=22
BACKUP_OFFSITE_USERNAME=
BACKUP_OFFSITE_PASSWORD=
# Isi dengan path file kunci, mis. /home/<user>/.ssh/siperkasa_backup (chmod 600), bukan isi kunci.
BACKUP_OFFSITE_PRIVATE_KEY=
BACKUP_OFFSITE_PASSPHRASE=
BACKUP_OFFSITE_ROOT=/backups/siperkasa
